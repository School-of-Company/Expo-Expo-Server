{
  "description": "박람회 기능 설정의 프론트·서버 공유 예제. docs/expo-feature-settings.md 참고. before/configuredOn/effectiveOn은 ON인 키 목록이며 나머지 키는 OFF다. blockedBy는 선택값이 ON인데 선행 기능 때문에 실효 OFF인 키만 담는다. catalog가 없으면 운영 카탈로그(GET /expo/{expo_id}/features의 features)를 쓴다.",
  "plans": [
    {
      "name": "설문 OFF + 추첨 선택 ON: 추첨 선택값은 남고 실효 OFF",
      "before": ["PRE_REGISTRATION", "SURVEY_LOTTERY"],
      "changes": {},
      "configuredOn": ["PRE_REGISTRATION", "SURVEY_LOTTERY"],
      "effectiveOn": ["PRE_REGISTRATION"],
      "blockedBy": { "SURVEY_LOTTERY": ["SURVEY"] },
      "autoEnabled": [],
      "reactivated": [],
      "deactivated": []
    },
    {
      "name": "부모 재활성화: 설문을 다시 켜면 보존된 추첨 선택이 실효 ON",
      "before": ["PRE_REGISTRATION", "SURVEY_LOTTERY"],
      "changes": { "SURVEY": true },
      "configuredOn": ["PRE_REGISTRATION", "SURVEY", "SURVEY_LOTTERY"],
      "effectiveOn": ["PRE_REGISTRATION", "SURVEY", "SURVEY_LOTTERY"],
      "blockedBy": {},
      "autoEnabled": [],
      "reactivated": ["SURVEY_LOTTERY"],
      "deactivated": []
    },
    {
      "name": "부모 OFF: 자식 선택값은 보존하고 실효만 OFF",
      "before": ["QR_ADMISSION", "PAPER_QR"],
      "changes": { "QR_ADMISSION": false },
      "configuredOn": ["PAPER_QR"],
      "effectiveOn": [],
      "blockedBy": { "PAPER_QR": ["QR_ADMISSION"] },
      "autoEnabled": [],
      "reactivated": [],
      "deactivated": ["PAPER_QR"]
    },
    {
      "name": "자식 ON: 선행 기능도 함께 ON",
      "before": [],
      "changes": { "TRAINING_ATTENDANCE": true },
      "configuredOn": ["TRAINING_PROGRAM", "TRAINING_ATTENDANCE"],
      "effectiveOn": ["TRAINING_PROGRAM", "TRAINING_ATTENDANCE"],
      "blockedBy": {},
      "autoEnabled": ["TRAINING_PROGRAM"],
      "reactivated": [],
      "deactivated": []
    },
    {
      "name": "여러 단계 선행 ON: 가장 아래 자식을 켜면 모든 조상이 ON",
      "catalog": [
        { "key": "BASE", "requires": [] },
        { "key": "MIDDLE", "requires": ["BASE"] },
        { "key": "LEAF", "requires": ["MIDDLE"] },
        { "key": "SIBLING", "requires": ["MIDDLE"] }
      ],
      "before": ["SIBLING"],
      "changes": { "LEAF": true },
      "configuredOn": ["BASE", "MIDDLE", "LEAF", "SIBLING"],
      "effectiveOn": ["BASE", "MIDDLE", "LEAF", "SIBLING"],
      "blockedBy": {},
      "autoEnabled": ["BASE", "MIDDLE"],
      "reactivated": ["SIBLING"],
      "deactivated": []
    }
  ],
  "invalidPlans": [
    {
      "name": "같은 요청에서 부모 OFF와 자식 ON은 모순(400)",
      "before": ["SURVEY"],
      "changes": { "SURVEY": false, "SURVEY_LOTTERY": true }
    },
    {
      "name": "알 수 없는 키(400)",
      "before": [],
      "changes": { "UNKNOWN_FEATURE": true }
    }
  ],
  "invalidCatalogs": [
    {
      "name": "중복 키",
      "catalog": [{ "key": "A", "requires": [] }, { "key": "A", "requires": [] }]
    },
    {
      "name": "없는 선행 키",
      "catalog": [{ "key": "A", "requires": ["MISSING"] }]
    },
    {
      "name": "순환",
      "catalog": [{ "key": "A", "requires": ["C"] }, { "key": "B", "requires": ["A"] }, { "key": "C", "requires": ["B"] }]
    }
  ]
}
