# Local development only
# 선택 설정: 기본 false. JSON과 UI를 함께 활성화한다.
# JSON: /expo/v3/api-docs, UI: /expo/swagger-ui.html (GET만 허용).
# Gateway 외부 접근은 별도 dev 문서 목록·공개 경로 설정이 필요하다.
SWAGGER_ENABLED=false
# 선택 설정: 기본 false. true이면 내부 경로와 X-Internal-Token 인증 설명을 포함한다.
SWAGGER_INCLUDE_INTERNAL=false
DB_URL=jdbc:postgresql://localhost:15432/expo
DB_USERNAME=expo
DB_PASSWORD=expo-local-only
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=16379
EUREKA_CLIENT_ENABLED=false
# Use a unique random secret in production (e.g. openssl rand -hex 32).
EXPO_INTERNAL_TOKEN=replace-with-local-secret
FORM_SERVICE_URL=http://localhost:3000
USER_SERVICE_URL=
APPLICATION_SERVICE_URL=
# Match each receiving service configuration; use distinct secrets in production.
USER_INTERNAL_TOKEN=replace-with-user-local-secret
APPLICATION_INTERNAL_TOKEN=replace-with-application-local-secret
FORM_INTERNAL_TOKEN=replace-with-form-local-secret
# Legacy fallback only when the target variable is absent (blank rejects internal calls).
# STANDARD_INTERNAL_TOKEN=
# TRAINING_INTERNAL_TOKEN=
# EXPO_DELETE_INTERNAL_TOKEN=
# SPKI PEM public key paired with Expo-User-Server JWT_PRIVATE_KEY; encode newlines as \n.
JWT_PUBLIC_KEY=
KAFKA_STANDARD_CREATED_ENABLED=false
KAFKA_TRAINING_SMS_ENABLED=false
KAFKA_TRAINING_SMS_CONTRACT_VERIFIED=false
KAFKA_TRAINING_SMS_RELAY_DELAY_MS=5000
KAFKA_TRAINING_SMS_BATCH_SIZE=20
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_STANDARD_CREATED_GROUP_ID=expo-expo-server.standard-created
# Attention 출석 조회. 실제 키 이름과 토큰은 Expo-Attention-Server 배포 설정과 맞춘다.
ATTENTION_SERVICE_URL=
ATTENTION_INTERNAL_TOKEN=replace-with-local-secret
